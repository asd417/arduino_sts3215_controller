# Sketch is parsed as an Uno build (AVR core 1.8.7). The driver comes from the
# sts3215_control library (junction in Documents/Arduino/libraries).
CompileFlags:
  Add:
    - -xc++
    - -std=gnu++11
    - --target=avr
    - -mmcu=atmega328p
    - -DARDUINO=10607
    - -DARDUINO_AVR_UNO
    - -DARDUINO_ARCH_AVR
    - -DF_CPU=16000000L
    - -IC:/Users/locti/AppData/Local/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino
    - -IC:/Users/locti/AppData/Local/Arduino15/packages/arduino/hardware/avr/1.8.7/variants/standard
    - -isystemC:/Users/locti/AppData/Local/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include
    - -IC:/Users/locti/OneDrive/Documents/Arduino/libraries/sts3215_control/src
    - -IC:/Users/locti/OneDrive/Documents/Arduino/libraries/LiquidCrystal_I2C
    - -IC:/Users/locti/AppData/Local/Arduino15/packages/arduino/hardware/avr/1.8.7/libraries/Wire/src
